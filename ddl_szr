-- 1. TABELAS PRINCIPAIS

CREATE TABLE TB_SZR_ENDERECO (
    id_endereco     INT NOT NULL,
    sg_estado       CHAR(2) NOT NULL,
    nm_cidade       VARCHAR(80) NOT NULL,
    nm_bairro       VARCHAR(80) NOT NULL,
    nm_logradouro   VARCHAR(80) NOT NULL,
    nr_latitude     DECIMAL(10,8) NOT NULL,
    nr_longitude    DECIMAL(11,8) NOT NULL,

    CONSTRAINT PK_SZR_ENDERECO
        PRIMARY KEY (id_endereco),

    CONSTRAINT CK_SZR_ENDERECO_NR_LATITUDE
        CHECK (nr_latitude BETWEEN -90 AND 90),

    CONSTRAINT CK_SZR_ENDERECO_NR_LONGITUDE
        CHECK (nr_longitude BETWEEN -180 AND 180)
)


CREATE TABLE TB_SZR_USUARIO (
    id_usuario                  INT NOT NULL,
    TB_SZR_ENDERECO_id_endereco INT NOT NULL,
    nm_usuario                  VARCHAR(80) NOT NULL,
    ds_email                    VARCHAR(120) NOT NULL,
    sg_categoria_usuario        CHAR(2) NOT NULL,
    url_img_perfil              VARCHAR(4000) NOT NULL,
    bio_usuario                 VARCHAR(250),
    ds_senha                    VARCHAR(255) NOT NULL,
    ds_url_contato              VARCHAR(4000) NOT NULL,

    CONSTRAINT PK_SZR_USUARIO
        PRIMARY KEY (id_usuario),

    CONSTRAINT UN_SZR_USUARIO_DS_EMAIL
        UNIQUE (ds_email),

    CONSTRAINT CK_SZR_USUARIO_SG_CATEGORIA_USUARIO
        CHECK (sg_categoria_usuario IN ('BS', 'P1', 'P2', 'P3')),

    CONSTRAINT FK_SZR_USUARIO_SZR_ENDERECO
        FOREIGN KEY (TB_SZR_ENDERECO_id_endereco)
        REFERENCES TB_SZR_ENDERECO (id_endereco)
)


CREATE TABLE TB_SZR_TAG (
    id_tag INT NOT NULL,
    nm_tag VARCHAR(80) NOT NULL,
    ds_tag VARCHAR(250) NOT NULL,

    CONSTRAINT PK_SZR_TAG
        PRIMARY KEY (id_tag)
)


CREATE TABLE TB_SZR_HABILIDADE (
    id_habilidade INT NOT NULL,
    nm_habilidade VARCHAR(80),
    ds_habilidade VARCHAR(250) NOT NULL,

    CONSTRAINT PK_SZR_HABILIDADE
        PRIMARY KEY (id_habilidade)
)


CREATE TABLE TB_SZR_MUSICA (
    id_musica           INT NOT NULL,
    duracao_segundos    INT NOT NULL,
    nm_musica           VARCHAR(80) NOT NULL,

    ds_musica VARCHAR(250)
        CONSTRAINT DF_SZR_MUSICA_DS_MUSICA
        DEFAULT ('MÚSICA SEM DESCRIÇÃO'),

    ds_letra VARCHAR(MAX)
        CONSTRAINT DF_SZR_MUSICA_DS_LETRA
        DEFAULT ('SEM LETRA FORNECIDA'),

    ds_url_musica VARCHAR(4000) NOT NULL,

    CONSTRAINT PK_SZR_MUSICA
        PRIMARY KEY (id_musica),

    CONSTRAINT CK_SZR_MUSICA_DURACAO_SEGUNDOS
        CHECK (duracao_segundos >= 0)
)


CREATE TABLE TB_SZR_OBRA (
    id_obra             INT NOT NULL,
    nm_obra             VARCHAR(80) NOT NULL,

    ds_obra VARCHAR(250)
        CONSTRAINT DF_SZR_OBRA_DS_OBRA
        DEFAULT ('OBRA SEM DESCRIÇÃO'),

    sg_classificacao    CHAR(1) NOT NULL,
    ds_url_img_capa     VARCHAR(4000) NOT NULL,
    dt_lancamento       DATE NOT NULL,

    CONSTRAINT PK_SZR_OBRA
        PRIMARY KEY (id_obra)
)


CREATE TABLE TB_SZR_PLAYLIST (
    id_playlist                 INT NOT NULL,
    TB_SZR_USUARIO_id_usuario   INT NOT NULL,
    nm_playlist                 VARCHAR(80) NOT NULL,
    ds_url_img_capa             VARCHAR(4000) NOT NULL,
    ds_playlist                 VARCHAR(250) NOT NULL,
    dt_criacao                  DATETIME NOT NULL,

    CONSTRAINT PK_SZR_PLAYLIST
        PRIMARY KEY (id_playlist),

    CONSTRAINT FK_SZR_PLAYLIST_SZR_USUARIO
        FOREIGN KEY (TB_SZR_USUARIO_id_usuario)
        REFERENCES TB_SZR_USUARIO (id_usuario)
)


CREATE TABLE TB_SZR_RESENHA (
    id_resenha                  INT NOT NULL,
    TB_SZR_USUARIO_id_usuario   INT NOT NULL,
    TB_SZR_MUSICA_id_musica     INT NOT NULL,
    ds_resenha                  VARCHAR(500) NOT NULL,
    dt_publicacao               DATETIME NOT NULL,

    CONSTRAINT PK_SZR_RESENHA
        PRIMARY KEY (id_resenha),

    CONSTRAINT FK_SZR_RESENHA_SZR_MUSICA
        FOREIGN KEY (TB_SZR_MUSICA_id_musica)
        REFERENCES TB_SZR_MUSICA (id_musica),

    CONSTRAINT FK_SZR_RESENHA_SZR_USUARIO
        FOREIGN KEY (TB_SZR_USUARIO_id_usuario)
        REFERENCES TB_SZR_USUARIO (id_usuario)
)

-- 2. TABELAS DO CLIPE E ARQUIVOS

CREATE TABLE TB_SZR_CLIPE (
    id_clipe                INT NOT NULL,
    ds_url_img_capa         VARCHAR(4000) NOT NULL,
    caminho_url             VARCHAR(4000) NOT NULL,
    dt_publicacao           DATETIME NOT NULL,
    nr_duracao_segundos     INT NOT NULL,
    TB_SZR_MUSICA_id_musica INT NOT NULL,

    CONSTRAINT PK_SZR_CLIPE
        PRIMARY KEY (id_clipe),

    CONSTRAINT UN_SZR_CLIPE_FK_MUSICA
        UNIQUE (TB_SZR_MUSICA_id_musica),

    CONSTRAINT CK_SZR_CLIPE_NR_DURACAO_SEGUNDOS
        CHECK (nr_duracao_segundos >= 0),

    CONSTRAINT FK_SZR_CLIPE_SZR_MUSICA
        FOREIGN KEY (TB_SZR_MUSICA_id_musica)
        REFERENCES TB_SZR_MUSICA (id_musica)
)


CREATE TABLE TB_SZR_ARQUIVO_RASCUNHO (
    id_arquivo                  INT NOT NULL,
    nm_arquivo                  VARCHAR(80) NOT NULL,
    ds_arquivo                  VARCHAR(250) NOT NULL,
    ds_url_arquivo              VARCHAR(4000) NOT NULL,
    sg_tipo_arquivo             CHAR(3) NOT NULL,
    dt_upload                   DATETIME NOT NULL,
    TB_SZR_USUARIO_id_usuario   INT NOT NULL,

    CONSTRAINT PK_SZR_ARQUIVO_RASCUNHO
        PRIMARY KEY (id_arquivo),

    CONSTRAINT CK_SZR_ARQUIVO_RASCUNHO_SG_TIPO_ARQUIVO
        CHECK (sg_tipo_arquivo IN ('ANT', 'DEM', 'IMG', 'LTR', 'AUD')),

    CONSTRAINT FK_SZR_ARQUIVO_RASCUNHO_SZR_USUARIO
        FOREIGN KEY (TB_SZR_USUARIO_id_usuario)
        REFERENCES TB_SZR_USUARIO (id_usuario)
)
