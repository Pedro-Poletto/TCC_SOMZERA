-- 5. MASCARAMENTO DINAMICO DE DADOS (DDM)
-- =========================================================

-- USUARIO: e-mail
ALTER TABLE TB_SZR_USUARIO
ALTER COLUMN ds_email
ADD MASKED WITH (FUNCTION = 'email()')


-- USUARIO: nome parcialmente visível
ALTER TABLE TB_SZR_USUARIO
ALTER COLUMN nm_usuario
ADD MASKED WITH (FUNCTION = 'partial(1,"XXXX",0)')


